APP_NAME="Warehouse Management WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=wms
DB_USERNAME=wms
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@wms.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WMS
WMS_BASE_DOMAIN=wms.test
WMS_DEMO_MODE=true
WMS_DEMO_PASSWORD=password
WMS_ALLOW_NEGATIVE_STOCK=false
WMS_HTTP_PORT=8080
WMS_MYSQL_PORT=3308
WMS_REDIS_PORT=6380
WMS_MAILPIT_UI_PORT=8025
WMS_MAILPIT_SMTP_PORT=1025
WMS_REVERB_PORT=8081

# Drutogoti performance profiler
DRUTOGOTI_ENABLED=true
DRUTOGOTI_STORAGE_DRIVER=sync
DRUTOGOTI_SAMPLE_RATE=1.0
DRUTOGOTI_SLOW_THRESHOLD_MS=100

# AI Hub (use fake in demo/tests)
AI_HUB_PROVIDER=fake
AI_HUB_FAILOVER=false
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Unicode PDF
UNICODE_PDF_ENGINE=native
UNICODE_PDF_DEFAULT_FONT="Noto Sans"

# Scout
SCOUT_DRIVER=database
